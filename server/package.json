{
  "name": "@zeemkolo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:railway": "prisma migrate deploy && node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:phase1": "vitest run src/modules/auth && tsx scripts/phase1-smoke.ts",
    "test:phase2": "vitest run src/modules/consultations && tsx scripts/phase2-smoke.ts",
    "test:phase3": "vitest run src/modules/lms && tsx scripts/phase3-smoke.ts",
    "test:phase4": "vitest run src/modules/forum && tsx scripts/phase4-smoke.ts",
    "test:phase5": "vitest run src/modules/store && tsx scripts/phase5-smoke.ts",
    "test:phase6": "tsx scripts/phase6-smoke.ts",
    "test:phase7": "vitest run src/modules/admin && tsx scripts/phase7-smoke.ts",
    "test:smoke": "tsx scripts/phase1-smoke.ts",
    "test:smoke:phase2": "tsx scripts/phase2-smoke.ts",
    "test:smoke:phase3": "tsx scripts/phase3-smoke.ts",
    "test:smoke:phase4": "tsx scripts/phase4-smoke.ts",
    "test:smoke:phase5": "tsx scripts/phase5-smoke.ts",
    "test:smoke:phase6": "tsx scripts/phase6-smoke.ts",
    "test:smoke:phase7": "tsx scripts/phase7-smoke.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "openapi:export": "tsx scripts/export-openapi.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@clerk/backend": "^1.21.0",
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.3.1",
    "@sentry/node": "^10.74.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.3.1",
    "resend": "^4.8.0",
    "svix": "^1.45.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
