# Server env template for Railway / production.
# Copy values into the Railway service Variables UI — never commit real secrets.

NODE_ENV=production
HOST=0.0.0.0
# Railway sets PORT automatically — do not hardcode in production.
# PORT=5000

# From Railway Postgres + Redis plugins (use reference variables):
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
DATABASE_URL=
REDIS_URL=

# Comma-separated — include Vercel production URL (+ previews if needed)
CORS_ORIGIN=https://YOUR_CLIENT.vercel.app,http://localhost:3000

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# R2 is required when NODE_ENV=production
R2_REQUIRED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zeemkolo-technical-solutions
R2_ENDPOINT=
R2_PUBLIC_URL=

DOWNLOAD_TOKEN_SECRET=
RESEND_API_KEY=
EMAIL_FROM=noreply@zeemkolo.com
ADMIN_EMAIL=admin@zeemkolo.com

LOG_LEVEL=info
SENTRY_DSN=
