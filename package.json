{
  "name": "zeemkolo",
  "private": true,
  "version": "0.1.0",
  "description": "Zeemkolo Technical Solutions — decoupled monorepo (client + server)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:client": "pnpm --filter @zeemkolo/client dev",
    "dev:server": "pnpm --filter @zeemkolo/server dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter @zeemkolo/server lint && pnpm --filter @zeemkolo/client exec tsc -p tsconfig.json --noEmit",
    "test:ci": "pnpm --filter @zeemkolo/server exec vitest run src/modules src/utils",
    "test:e2e": "playwright test",
    "test:e2e:http": "node scripts/o5-e2e-http-smoke.mjs",
    "audit:deps": "pnpm audit --audit-level=high",
    "db:up": "docker-compose up -d postgres redis",
    "db:down": "docker-compose stop postgres redis",
    "db:logs": "docker-compose logs -f postgres redis",
    "db:backup": "node -e \"require('fs').mkdirSync('backups',{recursive:true})\" && docker exec zeemkolo_postgres pg_dump -U zeemkolo_admin -d zeemkolo_db --clean --if-exists > backups/zeemkolo_db_latest.sql",
    "r2:login": "node scripts/r2-wrangler.mjs login",
    "r2:buckets": "node scripts/r2-wrangler.mjs r2 bucket list",
    "r2:info": "node scripts/r2.mjs info",
    "r2:ls": "node scripts/r2.mjs ls",
    "r2:head": "node scripts/r2.mjs head",
    "r2:get": "node scripts/r2.mjs get",
    "r2:put": "node scripts/r2.mjs put",
    "test:phase1": "pnpm --filter @zeemkolo/server test:phase1",
    "test:phase2": "pnpm --filter @zeemkolo/server test:phase2",
    "test:phase3": "pnpm --filter @zeemkolo/server test:phase3",
    "test:phase4": "pnpm --filter @zeemkolo/server test:phase4",
    "test:phase5": "pnpm --filter @zeemkolo/server test:phase5",
    "test:phase6": "pnpm --filter @zeemkolo/server test:phase6",
    "test:phase7": "pnpm --filter @zeemkolo/server test:phase7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.28.2",
    "@playwright/test": "^1.63.0",
    "wrangler": "^3.114.15"
  }
}
