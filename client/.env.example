# Client env for Vercel / local Next.js.
# On Vercel: Project → Settings → Environment Variables.
# Locally: copy to client/.env.local — never commit secrets.

# Public API base (Railway HTTPS URL, no trailing slash)
NEXT_PUBLIC_API_URL=https://YOUR_API.up.railway.app

# Clerk (Dashboard → API Keys — use Production keys for prod)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional
NEXT_PUBLIC_LOG_LEVEL=warn
NEXT_PUBLIC_SENTRY_DSN=
