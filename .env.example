# ── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (local Docker Compose) ─────────────────────────────────────────
POSTGRES_USER=zeemkolo_admin
POSTGRES_PASSWORD=zeemkolo_secret_password
POSTGRES_DB=zeemkolo_db
DATABASE_URL=postgresql://zeemkolo_admin:zeemkolo_secret_password@localhost:5432/zeemkolo_db?schema=public

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Server (Fastify) ────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ── Clerk (Identity) ────────────────────────────────────────────────────────
# Paste real values into `.env` only — never commit secrets here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Client (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zeemkolo-technical-solutions
R2_ENDPOINT=
R2_PUBLIC_URL=
CF_API_TOKEN=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@zeemkolo.com
ADMIN_EMAIL=admin@zeemkolo.com
